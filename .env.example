# Copier ce fichier en .env.local et renseigner les valeurs de votre projet Supabase
# (Project Settings > API dans le dashboard Supabase).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Utilisée uniquement par scripts/create-first-responsable.ts (jamais dans l'app mobile,
# jamais commitée). Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
