{
  "expo": {
    "name": "CivilMg",
    "slug": "CivilMg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "civilmg",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.proxiatech.civilmg",
      "supportsTablet": false
    },
    "android": {
      "package": "com.proxiatech.civilmg",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CivilMg utilise votre position pour enregistrer les coordonnées GPS de votre adresse, afin de faciliter la visite de vérification à domicile."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CivilMg a besoin d'accéder à vos photos pour joindre des pièces à votre dossier.",
          "cameraPermission": "CivilMg a besoin d'accéder à l'appareil photo pour photographier vos pièces justificatives."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
